<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- Ten khoản chi -->
        <TextView
            android:id="@+id/tvTenKhoanChi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="Ăn sáng"
            android:textColor="#111827"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Số tiền -->
        <TextView
            android:id="@+id/tvSoTien"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="30.000 đ"
            android:textColor="#DC2626"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Danh mục (Tag) -->
        <TextView
            android:id="@+id/tvDanhMuc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTenKhoanChi"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip_category"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="Ăn uống"
            android:textColor="#1D4ED8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Ngày chi tiêu -->
        <TextView
            android:id="@+id/tvNgay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/tvSoTien"
            android:layout_marginTop="10dp"
            android:text="12/10/2026"
            android:textColor="#6B7280"
            android:textSize="13sp" />
    </RelativeLayout>
</androidx.cardview.widget.CardView>